// Lamarck DOC Intelligence — schema inicial (fase de foundation).
//
// Este arquivo representa as quatro entidades aprovadas em docs/architecture.md,
// PROJECT_CONTEXT.md e nos ADRs em docs/decisions/. Nenhuma regra de negócio
// vive aqui — só a estrutura necessária para suportar os conceitos aprovados:
// deduplicação por SHA-256, fila de jobs persistida no PostgreSQL com
// claim/lease atômico, histórico imutável de processamento e um resultado
// flexível mas validado.
//
// Ownership: Claude é dono desta primeira versão completa (ver architecture.md
// §26 e PROJECT_CONTEXT.md §17 — "Ownership do schema Prisma inicial").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A state machine do documento aprovada em docs/specification.md §13 e
/// docs/architecture.md §12. Não adicione nem remova valores sem um ADR —
/// ver PROJECT_CONTEXT.md §22 (condições de parada).
enum DocumentStatus {
  RECEIVED
  PROCESSING
  RETRYING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

/// Resultado de uma única tentativa de processamento (ProcessingRun), não
/// confundir com DocumentStatus. STARTED é definido quando um worker começa
/// a tentativa; os outros três são estados terminais para aquele run.
enum ProcessingRunStatus {
  STARTED
  SUCCEEDED
  TECHNICAL_FAILURE
  SEMANTIC_MISMATCH
}

/// Um documento recebido. O PostgreSQL guarda metadata estruturada e a
/// storage key apenas — nunca o conteúdo do arquivo (ADR-003).
model Document {
  id        String   @id @default(uuid())
  sha256    String   @unique
  storageKey String  @unique

  /// Identificador livre do tipo de documento. Mantido como string simples
  /// (não enum) porque só um tipo está aprovado para a Fase 1
  /// (IDENTITY_DOCUMENT) e um segundo tipo já está planejado para a
  /// Fase 3 (docs/specification.md §24) — uma string evita uma migration
  /// só para adicionar um nome de tipo depois.
  documentType String

  status DocumentStatus @default(RECEIVED)

  /// Metadados do upload. originalFilename é só informativo — nunca deve
  /// ser usado como path no filesystem (ADR-003 / specification.md §20).
  originalFilename String
  mimeType         String
  sizeBytes        Int

  processingJob ProcessingJob?
  processingRuns ProcessingRun[]
  results       DocumentResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Linha operacional da fila para o processamento de um documento. Um job
/// por documento (ADR-002): retries reaproveitam esta mesma linha em vez
/// de criar novas — só o ProcessingRun cresce por tentativa. attemptCount
/// aqui é a fonte de verdade operacional do limite de 3 tentativas
/// (ADR-002, architecture.md §5/§13) — o limite de retry nunca deve ser
/// derivado contando linhas de ProcessingRun.
model ProcessingJob {
  id String @id @default(uuid())

  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id])

  attemptCount Int @default(0)

  /// Campos de claim/lease usados pela query de claim com
  /// FOR UPDATE SKIP LOCKED (architecture.md §10/§11, ADR-002). Um job
  /// pode ser reivindicado quando claimedBy é nulo ou leaseExpiresAt já
  /// passou. O worker dono do claim atual precisa ser reconferido antes
  /// de gravar o resultado final (fencing — architecture.md §11).
  claimedBy      String?
  claimedAt      DateTime?
  leaseExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseExpiresAt])
}

/// Uma linha por tentativa de processamento. Histórico imutável (ADR-005)
/// — nunca é atualizada para "corrigir" uma tentativa passada; reprocessar
/// cria uma nova linha. attemptNumber espelha o valor de
/// ProcessingJob.attemptCount vigente quando essa tentativa começou, só
/// para fins de auditoria — não guia a lógica de limite de retry.
model ProcessingRun {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  attemptNumber Int
  status        ProcessingRunStatus @default(STARTED)

  provider     String
  model        String?
  modelVersion String?

  promptId      String?
  promptVersion String?
  promptHash    String?

  outputSchemaVersion String?

  /// Só a categoria da falha técnica (ex.: "TIMEOUT", "PROVIDER_UNAVAILABLE").
  /// Nunca guarde aqui conteúdo do documento, campos extraídos ou qualquer
  /// dado pessoal (specification.md §21 / architecture.md §20-21).
  technicalErrorType String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  result DocumentResult?

  @@index([documentId])
}

/// Resultado extraído, mantido separado do documento (specification.md
/// §19). Ligado à execução que o produziu para o histórico continuar
/// explicável. Os dados estruturados ficam flexíveis (Json), mas a
/// aplicação ainda precisa validá-los antes de tratar um resultado como
/// válido — armazenamento flexível não significa aceitar qualquer
/// estrutura (architecture.md §17).
model DocumentResult {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  processingRunId String        @unique
  processingRun   ProcessingRun @relation(fields: [processingRunId], references: [id])

  documentType  String
  schemaVersion String
  data          Json

  createdAt DateTime @default(now())

  @@index([documentId])
}
