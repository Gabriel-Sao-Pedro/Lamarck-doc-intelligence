# Copy this file to .env and adjust if needed. Values below are safe local
# defaults for development — never put real credentials here.

# Postgres connection used by Prisma and by the application.
DATABASE_URL="postgresql://lamarck:lamarck@localhost:5432/lamarck_doc_intelligence?schema=public"

# Values consumed by docker-compose.yml (must stay consistent with DATABASE_URL above).
# If port 5432 is already used by another local Postgres, change POSTGRES_PORT
# here (and in DATABASE_URL above) to a free port, e.g. 5433.
POSTGRES_USER=lamarck
POSTGRES_PASSWORD=lamarck
POSTGRES_DB=lamarck_doc_intelligence
POSTGRES_PORT=5432

# HTTP port used by the NestJS application.
PORT=3000

# Local filesystem directory used by DocumentStorage in later phases.
# Not consumed by the foundation stage yet — kept here so the env contract is
# already visible before the storage module is implemented.
STORAGE_LOCAL_DIR=./storage
