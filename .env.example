# Copie este arquivo para .env e ajuste se necessário. Os valores abaixo são
# defaults seguros para desenvolvimento — nunca coloque credenciais reais aqui.

# Conexão com o Postgres usada pelo Prisma e pela aplicação.
DATABASE_URL="postgresql://lamarck:lamarck@localhost:5432/lamarck_doc_intelligence?schema=public"

# Valores consumidos pelo docker-compose.yml (precisam ficar consistentes com o DATABASE_URL acima).
# Se a porta 5432 já estiver em uso por outro Postgres local, troque POSTGRES_PORT
# aqui (e no DATABASE_URL acima) para uma porta livre, ex.: 5433.
POSTGRES_USER=lamarck
POSTGRES_PASSWORD=lamarck
POSTGRES_DB=lamarck_doc_intelligence
POSTGRES_PORT=5432

# Porta HTTP usada pela aplicação NestJS.
PORT=3000

# Diretório local do filesystem usado pelo DocumentStorage para gravar os
# arquivos enviados (src/storage/local-document-storage.ts).
STORAGE_LOCAL_DIR=./storage

# Opcionais, controlam o worker de processamento em segundo plano
# (src/processing/processing.worker.ts) — não precisam ser definidas para
# uso normal. Ver README.md > "Variáveis de ambiente" para detalhes.
# PROCESSING_WORKER_ENABLED=true
# PROCESSING_WORKER_POLL_INTERVAL_MS=1000
